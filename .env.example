# Copie para .env.local e preencha. Nunca coloque senhas aqui.
# Com as 4 variáveis obrigatórias vazias, o app roda em "modo local"
# (só o usuário gabalta, conferido por hash; o login com Google fica desabilitado).
# A config web do Firebase não é segredo: ela vai embutida no JS público.

# --- Firebase (obrigatórias para o modo Firebase) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase (opcionais) ---
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Dono ---
# E-mail da conta do dono no Firebase. O usuário "gabalta" faz login com este e-mail.
# Sem ele, "gabalta" não funciona no modo Firebase.
VITE_OWNER_EMAIL=
